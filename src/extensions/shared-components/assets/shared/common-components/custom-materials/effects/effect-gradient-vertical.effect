CCEffect %{
  techniques:
  - passes:
    - vert: sprite-vs:vert
      frag: sprite-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        alphaThreshold: { value: 0.5 }
        type:           { value: 0.0, target: type, editor: { displayName: type } }
        albedoTexture:  { value: grey, target: albedoMap, editor: { displayName: AlbedoMap } }
        topColor:       { value: [1,1,1,0], target: topColor, editor: { displayName: TopColor } }
        bottomColor:    { value: [1,0,0,0], target: bottomColor, editor: { displayName: BottomColor } }
}%

CCProgram sprite-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>

  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec2 uv0;
  out vec4 v_light;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1);

    pos = cc_matViewProj * pos;
    uv0 = a_texCoord;
    v_light = a_color;

    return pos;
  }
}%

CCProgram sprite-fs %{
  precision highp float;
  #include <builtin/internal/alpha-test>

  in vec2 uv0;
  in vec4 v_light;
  
  uniform sampler2D albedoMap;
  
  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  
  uniform GradientUBO
  { 
    mediump vec4 topColor;
    mediump vec4 bottomColor;
    float type;
  };

  vec4 frag () {
    vec4 o = vec4(1, 1, 1, 1);

    o *= texture(cc_spriteTexture, uv0);
    if(type == 0.0){
      o.rgb *= ((topColor - bottomColor) * smoothstep(bottomColor.a, topColor.a, 1.0 - uv0.y) + bottomColor).rgb;
    } else {
      o *= texture(albedoMap, uv0);
    }

     o.a = o.a * v_light.a;

    ALPHA_TEST(o);
    return o;
  }
}%
